APP_NAME=Land Scout Kazakhstan
APP_ENV=development
APP_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./land_scout.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
REDIS_URL=redis://localhost:6379/0
RUN_TASKS_INLINE=true
CLIENT_FUNNEL_VERSION=v2
ENABLE_STANDARD_LPH_10=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=

PLATFORM_ACCESS_PRICE_KZT=4990
TRIAL_ACCESS_ENABLED=true
TRIAL_ACCESS_DAYS=1
# Legacy aliases retained for compatibility with older deployments.
SEARCH_PRICE_KZT=4990
FREE_PREVIEW_ENABLED=true
FREE_PREVIEW_PLOT_LIMIT=3
PAID_SEARCH_ENABLED=true
PAYMENT_RECIPIENT=
PAYMENT_BANK_NAME=
PAYMENT_CARD_NUMBER=
PAYMENT_URL=https://pay.kaspi.kz/pay/l31wvjsj
APIPAY_ENABLED=false
APIPAY_API_KEY=
APIPAY_WEBHOOK_SECRET=
APIPAY_BASE_URL=https://api.apipay.kz/api/v1
APIPAY_TIMEOUT_SECONDS=30
APIPAY_POLLING_ENABLED=true
APIPAY_POLL_INTERVAL_SECONDS=20
APIPAY_POLL_ATTEMPTS=30

SMSC_ENABLED=false
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_BASE_URL=https://smsc.kz/sys/send.php
SMSC_SENDER=
SMSC_TIMEOUT_SECONDS=15

# Обязательные сведения о поставщике платной информационной услуги.
SERVICE_PROVIDER_NAME=
SERVICE_PROVIDER_STATUS=
SERVICE_PROVIDER_ID=
SERVICE_PROVIDER_ADDRESS=
SERVICE_PROVIDER_CONTACT=
DATA_STORAGE_LOCATION=Республика Казахстан
DATA_RETENTION_MONTHS=12

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
INTERNAL_API_KEY=

AUCTIONS_ENABLED=true
AUCTION_ACCESS_PRICE_KZT=4990
AUCTION_FREE_PREVIEW_LOTS=1
EQAZYNA_BASE_URL=https://sauda.e-qazyna.kz
EQAZYNA_SYNC_INTERVAL_MINUTES=30
EQAZYNA_SYNC_MAX_PAGES=10
EQAZYNA_SYNC_MAX_LOTS=100
EQAZYNA_TIMEOUT_SECONDS=30
EQAZYNA_VERIFY_TLS=true
AUCTION_V2_FULL_CYCLE_INTERVAL_MINUTES=15
AUCTION_V2_LIVE_OSM_ENABLED=true
AUCTION_V2_OSM_RADIUS_M=1200
AUCTION_V2_OSM_TTL_MINUTES=1440
AUCTION_V2_OBJECT_CLEARANCE_M=25
AUCTION_V2_POWER_CLEARANCE_M=30
AUCTION_V2_EVENT_LOOKBACK_HOURS=72
AUCTION_V2_EVENTS_PER_LOT_LIMIT=4
AUCTION_V2_LIVE_GOV_KZ_ENABLED=true
AUCTION_V2_GOV_KZ_PROJECTS=vko-altai,vko-shemonaiha,astana-saulet,almaty-zher,almobl-zher,karaganda-zher,shymkent-zher,abay-zher,akmola-zher,aktobe-zher,atyrau-zher,zko-zher,kostanay-zher,kyzylorda-zher,mangystau-zher,pavlodar-zher,sko-zher,turkestan-zher,zhambyl-zher,jetisu-zher,ulytau-zher
AUCTION_V2_GOV_KZ_DETAIL_URLS=
AUCTION_V2_GOV_KZ_INCLUDE_NEWS=false
AUCTION_V2_GOV_KZ_PAGE_SIZE=20
AUCTION_V2_GOV_KZ_MAX_PAGES=1
GOV_KZ_TIMEOUT_SECONDS=20
GOV_KZ_VERIFY_TLS=true
AUCTION_V2_LIVE_EGKN_ENABLED=true
AUCTION_V2_EGKN_TTL_MINUTES=1440
AUCTION_V2_EGKN_BATCH_SIZE=20
AUCTION_V2_EGKN_CONTEXT_ENABLED=true
AUCTION_V2_EGKN_CONTEXT_TTL_MINUTES=1440
AUCTION_V2_EGKN_CONTEXT_BATCH_SIZE=12
AUCTION_V2_EGKN_CONTEXT_RADIUS_M=1200
AUCTION_V2_EGKN_CONTEXT_MAX_FEATURES_PER_LAYER=25
AUCTION_V2_MAP_LIMIT=300

ENABLE_LIVE_OSM=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.private.coffee/api/interpreter
OSM_QUERY_TIMEOUT_SECONDS=25
OSM_TIME_BUDGET_SECONDS=120
OSM_BATCH_SIZE=8
MAX_LPH_NEIGHBOR_DISTANCE_M=15
OSM_ROAD_CLEARANCE_M=5
OSM_OPEN_WATER_CLEARANCE_M=30
URBAN_PLAN_CHECK_MODE=strict
URBAN_PLAN_RED_LINE_BUFFER_M=5
URBAN_PLAN_MAX_UPLOAD_MB=20
URBAN_PLAN_SOURCE_DOMAINS=gov.kz,adilet.zan.kz,egov.kz,map.gov.kz,map.gov4c.kz,gov.ggk.kz,aisgzk.kz,geo-shym.kz,geopavlodar.kz
EGKN_WFS_URL=https://map.gov4c.kz/geoserver/egkn/ows
EGKN_REST_URL=https://map.gov4c.kz/egkn/rest
EGKN_TIMEOUT_SECONDS=25
EGKN_REQUEST_ATTEMPTS=2
# У текущего публичного узла ЕГКН цепочка сертификатов может не проходить проверку httpx.
# Верните true, когда сертификат узла будет корректно проверяться на вашем сервере.
EGKN_VERIFY_TLS=false
SEARCH_MODE=live
LIVE_SEARCH_RADIUS_M=180
LIVE_SEARCH_TIME_BUDGET_SECONDS=180
LIVE_MAX_FEATURES=20000

# Used only when SEARCH_MODE=demo or SEARCH_MODE=hybrid.
DEMO_DATA_ENABLED=true
